# Supabase (NEW isolated project: vsyc26 — separate from yoyo-player-map)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...     # server-only — never exposed to browser

# Resend
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=vastateyoyocontest@dmvthrowers.club
RESEND_FROM_NAME=VSYC-26 Registration
RESEND_REPLY_TO=contact@dmvthrowers.club
# Admin "Send test" for survey invites goes here (default contact@dmvthrowers.club)
SURVEY_TEST_EMAIL=contact@dmvthrowers.club

# App
NEXT_PUBLIC_BASE_URL=https://register.dmvthrowers.club
NEXT_PUBLIC_VSYC_RULES_URL=https://dmvthrowers.club/vsyc26-rules.html
NEXT_PUBLIC_TICKET_TAILOR_SPECTATOR_URL=https://buytickets.at/dmvthrowers/2204711
NEXT_PUBLIC_CONTACT_EMAIL=contact@dmvthrowers.club

# Public results gate — leave unset/false until the contest is over, then set
# to true so /results shows final standings to the public.
RESULTS_PUBLISHED=false

# Admin basic auth — REQUIRED. Admin pages AND /api/admin routes return 401
# until ADMIN_PASSWORD is set (auth fails closed).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<generate-a-strong-password>

# Day-of dashboards — REQUIRED for the DJ portal and judge scoring.
# Use different values; share each only with the people working that station.
DJ_PIN=<pick-a-pin>
JUDGE_PIN=<pick-a-different-pin>

# Pricing config (ISO 8601 with ET offset — change without redeploy)
EARLY_BIRD_CUTOFF_ISO=2026-06-01T00:00:00-04:00
ONLINE_REG_CUTOFF_ISO=2026-09-17T23:59:59-04:00
MUSIC_DEADLINE_ISO=2026-09-17T23:59:59-04:00

# Upload token signing (random 32+ chars — generate with: openssl rand -base64 32)
UPLOAD_TOKEN_SECRET=<random-32-chars>

# Upstash/Vercel KV (for rate limiting — add via Vercel dashboard → Storage → KV)
KV_REST_API_URL=https://...
KV_REST_API_TOKEN=...

# Stripe (online card payments)
#   - Use sk_test_/pk_test_ keys while testing, sk_live_/pk_live_ in production.
#   - STRIPE_WEBHOOK_SECRET comes from Dashboard → Developers → Webhooks after you
#     add the endpoint:  {NEXT_PUBLIC_BASE_URL}/api/webhooks/stripe  (events: checkout.session.completed,
#     checkout.session.async_payment_succeeded, charge.refunded)
STRIPE_SECRET_KEY=sk_test_...                       # server-only — never exposed to browser
STRIPE_WEBHOOK_SECRET=whsec_...                     # server-only
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...      # safe to expose (not yet required, reserved for embedded checkout)

# Scheduled jobs (email outbox drain, Stripe payment reconcile)
#   Vercel cron sends it automatically; Supabase pg_cron reads the same value
#   from Vault (vsyc_cron_secret, see migration 0036). At least 16 characters.
CRON_SECRET=<random-32-chars>

# Email budget. Resend's free tier is 100/day per account, shared with the
# YoYo Map; 90 leaves a buffer for inbound mail. Bulk email (survey invites,
# reminders) stops RESERVE below the limit so confirmations always get through.
EMAIL_DAILY_LIMIT=90
EMAIL_PRIORITY_RESERVE=30
# Where duplicate-payment alerts go (default contact@dmvthrowers.club)
ADMIN_ALERT_EMAIL=contact@dmvthrowers.club
