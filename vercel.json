{
  "framework": "nextjs",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude,glob)*.md' ':(exclude,glob)**/README.md' ':(exclude)docs' ':(exclude).github'",
  "regions": ["iad1"],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false,
      "**": false
    }
  },
  "crons": [
    { "path": "/api/cron/drain-email", "schedule": "5 0 * * *" },
    { "path": "/api/cron/reconcile-payments", "schedule": "20 0 * * *" }
  ]
}
